{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "title": "Object Id",
          "type": "string"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        }
      },
      "required": [
        "object_id",
        "uri",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "InputManifestEntry": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "partition_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partition Key"
        }
      },
      "required": [
        "name",
        "artifact"
      ],
      "title": "InputManifestEntry",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "parent_run_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Parent Run Ids",
          "type": "array"
        }
      },
      "required": [
        "producer",
        "revision",
        "created_at"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "manifest_id": {
      "title": "Manifest Id",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/InputManifestEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "manifest_id",
    "entries",
    "provenance"
  ],
  "title": "InputManifest",
  "type": "object"
}
